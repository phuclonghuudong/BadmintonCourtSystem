model nhanvien {
  id          Int        @id @default(autoincrement())
  hoTen       String    
  email       String      @unique
  cccd        String?       @unique
  soDienThoai String       @unique
  gioiTinh    Int?
  diaChi      String?
  ngaySinh    DateTime?
  hinhAnh     String?
  trangThai   Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  datsan     datsan[]
  taikhoan   taikhoan[]
}