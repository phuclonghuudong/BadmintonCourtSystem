generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model chitietdatsan {
   id         Int      @id @default(autoincrement())
  datSanId   Int
  sanPhamId  Int
  giaBan     Float
  soLuong    Int
  ghiChu     String
  trangThai  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  datsan     datsan   @relation(fields: [datSanId], references: [id])
  sanpham    sanpham  @relation(fields: [sanPhamId], references: [id])

  @@index([datSanId])
  @@index([sanPhamId])
}


model chitietquyen {
   id            Int              @id @default(autoincrement())
  chucNangId    Int
  nhomQuyenId   Int
  hanhDong      String?
  moTa          String
  trangThai     Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  chucnang      danhmucchucnang  @relation(fields: [chucNangId], references: [id])
  nhomquyen     nhomquyen        @relation(fields: [nhomQuyenId], references: [id])

  @@index([chucNangId])
  @@index([nhomQuyenId])
}


model danhmucchucnang {
  id          Int              @id @default(autoincrement())
  maChucNang   String?        @unique
  tenChucNang  String?
  moTa        String
  trangThai   Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chitietquyen chitietquyen[]
}


model datsan {
   id            Int            @id @default(autoincrement())
  maDatSan      String
  sanId         Int
  khachHangId   Int
  nhanVienId    Int
  ngayDat       DateTime?
  checkIn       DateTime?
  checkOut      DateTime?
  giaSan        Float?
  tongTien      Float
  thanhToan     String
  ghiChu        String
  trangThai     Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  chitietdatsan chitietdatsan[]
  khachhang     khachhang      @relation(fields: [khachHangId], references: [id])
  nhanvien      nhanvien       @relation(fields: [nhanVienId], references: [id])
  san           san            @relation(fields: [sanId], references: [id])

  @@index([khachHangId])
  @@index([nhanVienId])
  @@index([sanId])
}


model giathue {
  id            Int      @id @default(autoincrement())
  sanId         Int
  khungGioId    Int
  thuTrongTuan  String?
  giaTien       Float?
  moTa          String
  trangThai     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  khunggio      khunggio @relation(fields: [khungGioId], references: [id])
  san           san      @relation(fields: [sanId], references: [id])

  @@index([khungGioId])
  @@index([sanId])
}


model khachhang {
  id          Int      @id @default(autoincrement())
  hoTen       String?
  email       String   @unique
  cccd        String   @unique
  soDienThoai String?  @unique
  gioiTinh    Int
  diaChi      String
  ngaySinh    DateTime
  trangThai   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  datsan     datsan[]
}

model khunggio {
  id          Int        @id @default(autoincrement())
  gioBatDau   String?
  gioKetThuc  String?
  moTa        String
  trangThai   Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  giathue   giathue[]
}

model loaisan {
  id        Int      @id @default(autoincrement())
  tenLoaiSan      String?
  moTa      String
  trangThai Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  san     san[]
}

model loaisanpham {
   id         Int       @id @default(autoincrement())
  tenLoaiSanPham       String?
  moTa       String
  trangThai  Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  sanpham  sanpham[]
}

model nhanvien {
  id          Int        @id @default(autoincrement())
  hoTen       String    
  email       String?      @unique
  cccd        String       @unique
  soDienThoai String?       @unique
  gioiTinh    Int
  diaChi      String
  ngaySinh    DateTime
  hinhAnh     String
  trangThai   Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  datsan     datsan[]
  taikhoan   taikhoan[]
}

model nhomquyen {
  id         Int           @id @default(autoincrement())
  maQuyen    String?        @unique // ADMIN, NHANVIEN, GUYST, ...
  tenQuyen        String?
  moTa       String
  trangThai  Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  chitietquyen chitietquyen[]
  taikhoan  taikhoan[]
}

model san {
  id          Int       @id @default(autoincrement())
  loaiSanId   Int
  tenSan      String?
  giaSan      Float?
  moTa        String
  hinhAnh     String
  trangThai   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  datsan     datsan[]
  giathue    giathue[]
  loaisan     loaisan   @relation(fields: [loaiSanId], references: [id])

  @@index([loaiSanId])
}

model sanpham {
  id              Int             @id @default(autoincrement())
  loaiSanPhamId   Int
  tenSanPham      String?
  giaSanPham      Float?
  soLuong       Int?
  donViTinh       String?
  moTa            String
  hinhAnh         String
  trangThai       Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  chitietdatsan  chitietdatsan[]
  loaisanpham     loaisanpham     @relation(fields: [loaiSanPhamId], references: [id])

  @@index([loaiSanPhamId])
}

model taikhoan {
  id                    Int       @id @default(autoincrement())
  nhanVienId            Int
  nhomQuyenId           Int
  tenDangNhap           String?
  matKhau               String?
  emailDaXacThuc        Boolean
  otpQuenMatKhau        String
  otpHetHanLuc          DateTime
  refreshToken          String
  trangThai             Int
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  nhanvien              nhanvien  @relation(fields: [nhanVienId], references: [id])
  nhomquyen             nhomquyen @relation(fields: [nhomQuyenId], references: [id])

  @@index([nhanVienId])
  @@index([nhomQuyenId])
}