generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model NhanVien {
  MaNhanVien  Int       @id @default(autoincrement())
  Hoten       String
  Email       String?
  CCCD        String
  SoDienThoai String
  GioiTinh    Int
  DiaChi      String
  NgaySinh    DateTime
  HinhAnh     String
  TrangThai   Int
  created     DateTime  @default(now())
  updated     DateTime  @updatedAt

  TaiKhoan    TaiKhoan[]
  DatSans     DatSan[]
}

model KhachHang {
  MaKhachHang Int       @id @default(autoincrement())
  Hoten       String
  Email       String?
  CCCD        String
  SoDienThoai String?
  GioiTinh    Int
  DiaChi      String
  NgaySinh    DateTime
  HinhAnh     String
  TrangThai   Int
  created     DateTime  @default(now())
  updated     DateTime  @updatedAt

  DatSans     DatSan[]
}

model NhomQuyen {
  MaNhomQuyen Int       @id @default(autoincrement())
  TenNhomQuyen String?
  MoTa        String
  TrangThai   Int
  created     DateTime  @default(now())
  updated     DateTime  @updatedAt

  TaiKhoans   TaiKhoan[]
  ChiTietQuyens ChiTietQuyen[]
}

model TaiKhoan {
  ID                   Int       @id @default(autoincrement())
  MaNhanVien           Int
  MaNhomQuyen          Int
  TenDangNhap          String?
  MatKhau              String?
  VerifyEmail          Boolean
  ForgotPasswordOtp    String
  ForgotPasswordExpiry DateTime
  RefreshToken         String
  TrangThai            Int
  created              DateTime  @default(now())
  updated              DateTime  @updatedAt

  nhanVien   NhanVien   @relation(fields: [MaNhanVien], references: [MaNhanVien])
  nhomQuyen  NhomQuyen  @relation(fields: [MaNhomQuyen], references: [MaNhomQuyen])
}

model LoaiSan {
  MaLoaiSan  Int       @id @default(autoincrement())
  TenLoaiSan String?
  Mota       String
  TrangThai  Int
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  Sans       San[]
}

model LoaiSanPham {
  MaLoaiSanPham Int      @id @default(autoincrement())
  TenLoaiSanPham String?
  Mota           String
  TrangThai      Int
  created        DateTime @default(now())
  updated        DateTime @updatedAt

  SanPhams       SanPham[]
}

model SanPham {
  MaSanPham   Int       @id @default(autoincrement())
  MaLoaiSanPham Int
  TenSanPham  String?
  GiaSanPham  Float?
  DonViTinh   Int?
  MoTa        String
  HinhAnh     String
  TrangThai   Int
  created     DateTime  @default(now())
  updated     DateTime  @updatedAt

  loaiSanPham LoaiSanPham @relation(fields: [MaLoaiSanPham], references: [MaLoaiSanPham])
  ChiTietDatSans ChiTietDatSan[]
}

model San {
  MaSan      Int       @id @default(autoincrement())
  MaLoaiSan  Int
  TenSan     String?
  GiaSan     Float?
  MoTa       String
  HinhAnh    String
  TrangThai  Int
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  loaiSan    LoaiSan   @relation(fields: [MaLoaiSan], references: [MaLoaiSan])
  GiaThues   GiaThue[]
  DatSans    DatSan[]
}

model KhungGio {
  MaKhungGio Int       @id @default(autoincrement())
  GioBatDau  String?
  GioKetThuc String?
  MoTa       String
  TrangThai  Int
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  GiaThues   GiaThue[]
}

model GiaThue {
  MaGiaThue  Int       @id @default(autoincrement())
  MaSan      Int
  MaKhungGio Int
  ThuTrongTuan String?
  GiaTien    Float?
  MoTa       String
  TrangThai  Int
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  san        San       @relation(fields: [MaSan], references: [MaSan])
  khungGio   KhungGio  @relation(fields: [MaKhungGio], references: [MaKhungGio])
}

model DatSan {
  ID         Int       @id @default(autoincrement())
  MaDatSan   String
  MaSan      Int
  MaKhachHang Int
  MaNhanVien Int
  NgayDat    DateTime?
  CheckIn    DateTime?
  CheckOut   DateTime?
  GiaSan     Float?
  TongTien   Float
  ThanhToan  String
  GhiChu     String
  TrangThai  Int
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  khachHang  KhachHang @relation(fields: [MaKhachHang], references: [MaKhachHang])
  nhanVien   NhanVien  @relation(fields: [MaNhanVien], references: [MaNhanVien])
  san        San       @relation(fields: [MaSan], references: [MaSan])
  chiTietDatSans ChiTietDatSan[]
}

model ChiTietDatSan {
  ID         Int       @id @default(autoincrement())
  MaDatSan   Int
  MaSanPham  Int
  GiaBan     Float
  SoLuong    Int
  GhiChu     String
  TrangThai  Int
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  datSan     DatSan    @relation(fields: [MaDatSan], references: [ID])
  sanPham    SanPham   @relation(fields: [MaSanPham], references: [MaSanPham])
}

model DanhMucChucNang {
  MaChucNang Int       @id @default(autoincrement())
  TenChucNang String?
  MoTa       String
  TrangThai  Int
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  ChiTietQuyens ChiTietQuyen[]
}

model ChiTietQuyen {
  ID         Int       @id @default(autoincrement())
  MaChucNang Int
  MaNhomQuyen Int
  HanhDong   String?
  MoTa       String
  TrangThai  Int
  created    DateTime  @default(now())
  updated    DateTime  @updatedAt

  chucNang   DanhMucChucNang @relation(fields: [MaChucNang], references: [MaChucNang])
  nhomQuyen  NhomQuyen       @relation(fields: [MaNhomQuyen], references: [MaNhomQuyen])
}
